# ===== Server =====
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS / Socket.IO.
# Use * during local development with the Flutter app.
CORS_ORIGIN=*

# ===== Database =====
# Local MongoDB:        mongodb://127.0.0.1:27017/chatt
# MongoDB Atlas (cloud): mongodb+srv://<user>:<pass>@<cluster>/chatt
MONGO_URI=mongodb://127.0.0.1:27017/chatt

# PostgreSQL (used by new config)
# Example values for local Postgres; replace with your DB server values
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatt_db
DB_USER=postgres
DB_PASSWORD=postgres

# ===== Auth (JWT) =====
# Generate a strong secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# ===== Mail (SMTP) =====
# Required for sending emails (account credentials)
SMTP_EMAIL=you@example.com
SMTP_PASS=your-smtp-password
ADMIN_EMAIL=admin@example.com
